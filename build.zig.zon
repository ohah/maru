.{
    .name = .maru,
    .version = "0.0.0",
    .fingerprint = 0x9c7bcf1233561811, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // **코어는 crates.io 소스 배포본을 쓴다 — GitHub 태그 tarball이 아니다.** 상류 저장소의
        // `build.zig`가 0.16에서 제거된 API(`Compile.addCSourceFile`)를 부르는데, `lazyDependency`는
        // 의존성의 `build.zig`를 **실행**하므로 우리가 그 파일에서 아무것도 안 가져와도 빌드가 거기서
        // 죽는다(`error: no field or member function named 'addCSourceFile'`). crates.io 배포본에는
        // `build.zig`가 아예 없어 실행될 것이 없다 — 우리는 `.path()`로 C 파일만 집으므로 그것으로 족하다.
        //
        // **같은 소스다.** 두 배포본의 `src/` 파일 목록이 동일하고, `lib/`가 최상위로 올라온 것만 다르다
        // (GitHub `lib/src/lib.c` = crates.io `src/lib.c`). 상류를 올릴 때 이 경로 차이를 다시 본다.
        .tree_sitter = .{
            .url = "https://crates.io/api/v1/crates/tree-sitter/0.26.13/download",
            .hash = "N-V-__8AAL-4DwDqYmHs5DVYbTLiXtPrbInxHqqJ8wa_Y__d",
        },
        .tree_sitter_zig = .{
            .url = "https://github.com/tree-sitter-grammars/tree-sitter-zig/archive/refs/tags/v1.1.2.tar.gz",
            .hash = "N-V-__8AAN6NXgCZxLUnqe4620P_FqHrEY8PHTA1-VlOn4yX",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "docs",
        // W7.6: 번들 ConPTY(`conpty.dll` + `OpenConsole.exe`, MIT). 여기 없으면 패키지로 소비될 때
        // 빠져서 Windows 마우스가 조용히 죽는다 — `build.zig`는 파일이 없으면 그냥 안 넣는다.
        "assets",
        "LICENSE",
        "terminal-strategy.md",
        "AGENTS.md",
        ".mise.toml",
        ".gitignore",
    },
}
