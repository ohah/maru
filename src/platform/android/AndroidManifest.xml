<?xml version="1.0" encoding="utf-8"?>
<!-- host 는 `NativeActivity` 를 상속한 `MaruActivity` 다. 상속하는 이유는 **IME 하나**다 —
     소프트 키보드가 만든 한글을 `InputConnection` 으로 받으려면 Java 쪽 진입점이 필요하다.
     구글의 `GameActivity` 는 `AppCompatActivity` 를 상속해 AndroidX·Gradle 을 끌고 와서
     쓰지 않는다(docs/mobile-platform.md §1). `android.*` 만 쓰므로 의존은 여전히 0 이다.

     화면 방향은 portrait 로 고정한다 — 앞 오프스크린 단계에서 가로로 나온 지적을 여기서는
     창 자체가 세로가 되게 해서 푼다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="dev.maru.chrome">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
    <!-- 원격 세션(SSH)에 필요한 것들. **포그라운드 서비스가 아니면 배경에서 소켓이 끊긴다** —
         OS 가 프로세스를 거두기 때문이고, 그러면 "잠깐 다른 앱 봤더니 끊겼다" 가 매번 난다.
         API 34 부터는 종류(`dataSync`)를 매니페스트와 코드 양쪽에서 밝혀야 한다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- **선언만으로는 안 된다**(API 33+). 이 줄이 없으면 요청 자체가 무시되고, 이 줄만 있고
         런타임 요청이 없으면 알림이 «떠 있으면서 안 보인다» — 실제로 그 상태였다(M16c).
         묻는 자리는 `MaruActivity.startSsh`(계약 §3.3). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- **`debuggable` 이 여기 없다**(M11a — 계약 §3.4). 개발 빌드에는 필요하지만(`run-as` 로 앱
         내부의 래스터 결과를 꺼내 두 플랫폼 픽셀을 대조한다 — tools/mobile-harness/atlas_diff.py)
         그 값이 배포에 실리면 **아무나 앱 저장소를 꺼낸다** — 우리가 개인키를 봉인해 두는 바로
         그 자리다. 그래서 **기본값은 안전**이고 하네스가 개발 빌드에만 끼워 넣는다: 잊어서
         켜지는 일은 있어도 **잊어서 꺼지는 일은 없다.** -->
    <application android:label="MaruChrome">
        <!-- configChanges 에 fontScale 을 넣는 이유: 안 넣으면 시스템 글자 크기를 바꿀 때
             액티비티가 **통째로 재생성**된다 — NativeActivity 라 창·스왑체인·아틀라스가 다 다시
             서고 화면이 한 번 끊긴다. 직접 받으면 onConfigurationChanged 에서 배율만 알리고
             그 프레임에 아틀라스를 다시 굽는다(M13b·M13c). -->
        <activity android:name="dev.maru.MaruActivity"
                  android:label="MaruChrome"
                  android:screenOrientation="unspecified"
                  android:configChanges="orientation|keyboardHidden|screenSize|uiMode|fontScale"
                  android:windowSoftInputMode="adjustResize"
                  android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="maruchrome" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 소켓을 드는 자리. `exported=false` — 다른 앱이 우리 세션을 시작할 이유가 없다. -->
        <service android:name="dev.maru.MaruSshService"
                 android:foregroundServiceType="dataSync"
                 android:exported="false" />
    </application>
</manifest>
