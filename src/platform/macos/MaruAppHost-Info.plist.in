<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- bare 실행파일(.app 번들 없음)에 __TEXT,__info_plist 섹션으로 임베드한다. macOS는
         번들이 없는 앱의 이 섹션을 Info.plist로 읽는다. NSHighResolutionCapable이 없으면
         창이 1x backing store로 렌더되어 Retina에서 업스케일로 흐려진다. -->
    <key>CFBundleName</key>
    <string>Maru</string>
    <key>CFBundleDisplayName</key>
    <string>Maru</string>
    <key>CFBundleIdentifier</key>
    <string>@@MARU_BUNDLE_ID@@</string>
    <key>CFBundleExecutable</key>
    <string>maru-macos-app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- **앱 아이콘**(M11b — 앰버 커서 모티프). 그림은 `assets/icon/` 이 소유하고 한 생성기가
         세 플랫폼 것을 함께 뽑는다(`assets/icon/render.py`) — 크기가 스물 몇 개라 손으로 맞추면
         한 자리만 낡는다. 여기 이름은 확장자 없이 적는다(`Resources/Maru.icns` 를 가리킨다). -->
    <key>CFBundleIconFile</key>
    <string>Maru</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@@MARU_VERSION@@</string>
    <key>CFBundleVersion</key>
    <string>@@MARU_BUNDLE_VERSION@@</string>
    <!-- 실행 가능한 최소 macOS 버전. Apple Silicon(arm64)은 11.0(Big Sur)부터 시작하므로
         arm64 단일 빌드의 하한이 11.0이다. build.zig의 default_target os_version_min과 값을 맞춘다. -->
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 번들 Contents/Resources/Fonts 안의 폰트를 앱 실행 시 자동 등록한다. 시스템에 폰트가
         설치돼 있지 않아도 기본 폰트(JetBrains Mono)를 항상 쓸 수 있게 한다(self-contained). -->
    <key>ATSApplicationFontsPath</key>
    <string>Fonts</string>
</dict>
</plist>
