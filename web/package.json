{
  "name": "@maru/file-panel-web",
  "private": true,
  "type": "module",
  "scripts": {
    "web:build": "bun run scripts/build.ts && bun run scripts/verify-build.ts",
    "web:test": "bun test",
    "web:typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.bridge.json && tsc -p tsconfig.ui.json",
    "web:lint": "oxlint src scripts tests",
    "web:fmt": "oxfmt --write src scripts tests package.json tsconfig.json tsconfig.bridge.json tsconfig.ui.json",
    "web:fmt-check": "oxfmt --check src scripts tests package.json tsconfig.json tsconfig.bridge.json tsconfig.ui.json",
    "web:licenses": "bun run scripts/audit-licenses.ts",
    "web:check": "bun run web:build && bun run web:test && bun run web:typecheck && bun run web:lint && bun run web:fmt-check && bun run web:licenses"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@tiptap/core": "^3",
    "@tiptap/extension-image": "^3",
    "@tiptap/extension-table": "^3",
    "@tiptap/extension-table-cell": "^3",
    "@tiptap/extension-table-header": "^3",
    "@tiptap/extension-table-row": "^3",
    "@tiptap/extension-task-item": "^3",
    "@tiptap/extension-task-list": "^3",
    "@tiptap/markdown": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/starter-kit": "^3",
    "clsx": "^2.1.1",
    "dompurify": "3.4.12",
    "mermaid": "11.16.0",
    "react": "^19",
    "react-dom": "^19",
    "rehype-katex": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwind-merge": "^3.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-toolbar": "^1.1.19",
    "@tailwindcss/cli": "^4",
    "@types/bun": "1.3.11",
    "@types/hast": "3.0.4",
    "@types/jsdom": "28.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@zntc/core": "0.1.4",
    "jsdom": "29.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "engines": {
