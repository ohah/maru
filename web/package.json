{
  "name": "@maru/file-panel-web",
  "private": true,
  "type": "module",
  "scripts": {
    "web:build": "bun run scripts/build.ts && bun run scripts/verify-build.ts",
    "web:test": "bun test",
    "web:live-preview-perf": "bun run scripts/live-preview-perf.ts",
    "web:typecheck": "tsc -p tsconfig.bridge.json",
    "web:lint": "oxlint src scripts tests",
    "web:fmt": "oxfmt --write src scripts tests package.json tsconfig.json tsconfig.bridge.json",
    "web:fmt-check": "oxfmt --check src scripts tests package.json tsconfig.json tsconfig.bridge.json",
    "web:licenses": "bun run scripts/audit-licenses.ts",
    "web:check": "bun run web:build && bun run web:test && bun run web:typecheck && bun run web:lint && bun run web:fmt-check && bun run web:licenses"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "dompurify": "3.4.12",
    "mermaid": "11.16.0",
    "rehype-katex": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/hast": "3.0.4",
    "@types/jsdom": "28.0.3",
    "@zntc/core": "0.1.3",
    "jsdom": "29.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  }
}
