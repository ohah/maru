{
  "extends": "./tsconfig.json",
  // 루트 설정에 target이 없어 ES5로 내려가면 Map 순회 등이 전부 오류가 된다 — 여기서 명시한다.
  "compilerOptions": { "target": "ES2022", "skipLibCheck": true },
  // 소스와 빌드 스크립트 **전체**를 검사한다. 예전에는 `bridge`/`ui` 두 설정(각각 두 파일·UI 폴더)만 돌아서
  // 나머지 소스가 검사 밖이었고, 선언이 사라진 참조가 그대로 번들에 실려 런타임에 죽었다(실측).
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"]
}
